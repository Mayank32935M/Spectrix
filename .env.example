# SPECTRIX Environment Configuration
SPECTRIX_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true

# Database
# Use SQLite for standalone local-first execution or PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://spectrix:spectrix_dev@localhost:5432/spectrix_db
DATABASE_URL=sqlite:///./spectrix.db

# Storage Vault
STORAGE_VAULT_PATH=./storage/uploads
DERIVATIVES_PATH=./storage/derivatives
TEMP_PATH=./storage/temp
MAX_UPLOAD_SIZE_BYTES=1073741824 # 1GB

# Redis & Celery (Optional in standalone mode)
REDIS_URL=redis://localhost:6379/0

# Neo4j Graph Projection (Optional in standalone mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=spectrix_graph

# Secret Key
SECRET_KEY=dev_secret_key_change_in_production_883a90

